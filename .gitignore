# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/
.pnpm/

# Build outputs
dist/
build/

# Local environment files
.env
.env.local
.env.*.local

# Editor/IDE stuff
.vscode/
.idea/
*.swp
*.swo
*.bak

# OS-specific files
.DS_Store
Thumbs.db

# Database files (keep schema, ignore local DB dumps)
*.sqlite
*.db
# keep user_db.sql tracked!
!user_db.sql

# Cache
.vite/
.cache/
.tmp/
vite-cache/
coverage/

# Docker/local orchestration overrides
docker-compose.override.yml
*.env.docker

# GeoServer local raster drops (mounted into container)
# Keep placeholder folder tracked via .gitkeep.
infrastructure/geoserver/rasters/*.tif
infrastructure/geoserver/rasters/*.tiff
infrastructure/geoserver/rasters/*.img
infrastructure/geoserver/rasters/*.vrt
infrastructure/geoserver/rasters/*.asc
!infrastructure/geoserver/rasters/.gitkeep

# Misc
*.tgz
